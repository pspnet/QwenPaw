{
  "//": [
    "`types: []` disables automatic @types/* registration.",
    "Window globals are declared in `src/qwenpaw-host.d.ts`."
  ],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src"]
}
